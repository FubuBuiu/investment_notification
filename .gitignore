*.db
*.db-journal
dev.db
dev.db-journal
test.db
test.db-journal

# Migrations geradas automaticamente em dev (opcional)
# Descomente se quiser ignorar migrations locais
# prisma/migrations/

# Cliente gerado (se usar output customizado)
# prisma/generated/

# ============================================
# FASTIFY / SERVIDOR
# ============================================
# Arquivos de PID
*.pid
*.seed
*.pid.lock

# Uploads temporários
uploads/
tmp/
temp/
*.tmp

# ============================================
# TYPESCRIPT (se usar)
# ============================================
*.js
*.js.map
*.d.ts
!jest.config.js
!eslint.config.js

# ============================================
